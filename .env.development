# =======================================
# DEVELOPMENT ENVIRONMENT
# =======================================

# Database Configuration
# Khi chạy Docker Compose: dùng tên service 'sqlserver'
# Khi chạy local dotnet: dùng 'localhost' hoặc tên máy
DB_SERVER=sqlserver
DB_NAME=UngDungXemPhim_v2
DB_USER=sa
DB_PASSWORD=YourStrong@Password123
DB_TRUST_CERTIFICATE=True

# API Configuration
API_PORT=5016
API_HOST=0.0.0.0
# Khi chạy Docker: dùng localhost
# Khi chạy trên mạng LAN: thay bằng IP máy
ASSET_BASE_URL=http://localhost:5016/Assets

# Logging
LOG_LEVEL=Information
ASPNET_LOG_LEVEL=Warning

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Frontend
# Khi test backend, không cần chạy frontend ngay
EXPO_PUBLIC_API_URL=http://localhost:5016/api
EXPO_PUBLIC_ASSET_URL=http://localhost:5016/Assets
